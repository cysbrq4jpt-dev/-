# ===== Discord =====
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_BOT_TOKEN=your-discord-bot-token
# アプリケーション(クライアント)ID
DISCORD_CLIENT_ID=your-discord-application-id

# ===== Claude 認証 =====
# 【推奨】Claude サブスク(Pro/Max等)で使う場合:
#   ローカルで `claude setup-token` を実行して発行したトークンを設定。
CLAUDE_CODE_OAUTH_TOKEN=
# 従量課金(API)で使う場合はこちら(OAuthトークンと排他)。
# ANTHROPIC_API_KEY=
# 使用モデル(省略可)
ANTHROPIC_MODEL=claude-sonnet-5

# ===== GitHub =====
# リポジトリの clone / push / PR作成に使う Personal Access Token。
# 未設定でも公開リポジトリの読み取りは可能(push/PRは不可)。
# 権限: repo (private も扱うなら) / public_repo
GITHUB_TOKEN=

# コミット時の著者情報(省略可)
GIT_AUTHOR_NAME=Claude Discord Bot
GIT_AUTHOR_EMAIL=claude-bot@users.noreply.github.com

# ===== 保存先(省略可) =====
# リポジトリの clone 先
WORKSPACE_DIR=./workspace
# チャンネル紐付け情報の保存先
DATA_DIR=./data

# ===== アクセス制限(任意) =====
# 操作を許可するリポジトリ(カンマ区切りの owner/name)。空なら制限なし。
ALLOWED_REPOS=

# ===== 挙動(任意) =====
# true にすると、どのチャンネルでもメンション(@)不要で応答する。
RESPOND_WITHOUT_MENTION=
