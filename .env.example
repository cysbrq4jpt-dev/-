# ===== Discord =====
# Discord Developer Portal (https://discord.com/developers/applications) で取得
DISCORD_BOT_TOKEN=your-discord-bot-token
# アプリケーション(クライアント)ID。スラッシュコマンド登録に使用
DISCORD_CLIENT_ID=your-discord-application-id

# ボットが反応するチャンネルID(カンマ区切りで複数指定可)。
# 空にすると、ボットがメンションされた時のみ全チャンネルで反応します。
ALLOWED_CHANNEL_IDS=

# ===== Claude 認証 =====
# 【推奨】Claude サブスク(Pro/Max等)で使う場合:
#   ローカルで `claude setup-token` を実行して発行したトークンを設定。
#   これを使うと従量課金ではなくサブスク枠で動きます。
CLAUDE_CODE_OAUTH_TOKEN=

# 従量課金(API)で使う場合はこちらを設定(OAuthトークンとどちらか一方でOK)。
# 注意: 両方設定すると ANTHROPIC_API_KEY が優先され、従量課金になります。
# ANTHROPIC_API_KEY=

# 使用するモデル(省略可)
ANTHROPIC_MODEL=claude-sonnet-5
